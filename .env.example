# Copy to .env (ignored by Git), chmod 600 .env, then fill in your values.
# Use absolute paths for optional path overrides. Existing environment wins.
T3_FACTORY_CONFIG=/absolute/path/to/config.jsonc
# Required project-scoped Kanvil API credential for the scheduler account.
# KANVIL_API_KEY=
T3_FACTORY_SERVICE_LABEL=local.t3-factory
T3_FACTORY_MENU_BUNDLE_ID=local.t3-factory.menu
FACTORY_WEB_HOST=127.0.0.1
FACTORY_WEB_PORT=3848
FACTORY_PUBLIC_ORIGIN=https://factory.example.com
FACTORY_AUTH_MODE=oidc
OIDC_ISSUER=https://sso.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REQUIRED_GROUP=factory-admins
OIDC_SESSION_HOURS=720
OIDC_RECHECK_SECONDS=60
# Only required with FACTORY_AUTH_MODE=pairing; use a long random value.
FACTORY_WEB_SESSION_SECRET=
FACTORY_HOSTNAME=factory.example.com
FACTORY_WEB_UPSTREAM=127.0.0.1:3848
CLOUDFLARE_API_TOKEN=
CADDY_BINARY=caddy

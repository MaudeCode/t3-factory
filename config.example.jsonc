{
  // Replace all placeholders before using live integrations. Start paused.
  "enabled": false,
  "pollSeconds": 60,
  // Queue wait and read-only manual checks, ending at durable launch ownership.
  "manualPrelaunchSeconds": 60,
  "idleMinutes": 30,
  "maxWaitingPRs": null,
  // Free bytes required on the repository's filesystem before a run starts; 0 disables the check.
  "minFreeSpaceBytes": 1073741824,
  "concurrency": { "claude": 1, "codex": 1 },
  "monitoringTimeoutMinutes": 30,
  "runtimeMode": "auto",
  "stateDir": "/absolute/path/to/factory-state",
  "t3": {
    "url": "http://127.0.0.1:3773",
    "credentialFile": "/absolute/path/to/t3-session.json",
    // Non-Factory autonomous workflows that should not block personal idle.
    "autonomousThreadIds": []
  },
  "kanvil": {
    "url": "https://kanvil.example.com",
    "workspaceId": "YOUR_WORKSPACE_ID"
  },
  "models": [
    {
      "id": "default-model",
      "name": "My model",
      "model": {
        "instanceId": "YOUR_T3_PROVIDER_INSTANCE_ID",
        "model": "YOUR_T3_MODEL_SLUG",
        "options": []
      },
      "automatic": false,
      "maxDifficulty": "med"
    }
  ],
  // Illustrative policy, not a recommendation for a particular subscription.
  "quota": {
    "maxAgeSeconds": 120,
    "claude": {
      "fiveHour": { "reservePercent": 50, "minRemainingPercent": 10 },
      "weekly": { "reservePercent": 50, "minRemainingPercent": 10 },
      "fable": { "reservePercent": 0, "minRemainingPercent": 15 }
    },
    "codex": {
      "weekly": { "reservePercent": 50, "minRemainingPercent": 10 }
    }
  },
  "discovery": {
    "promptFile": "/absolute/path/to/discovery.md",
    "emptyCooldownHours": 24
  },
  // Optional: required once any project has an inbox.
  "triage": {
    "enabled": false,
    "promptFile": "/absolute/path/to/inbox-triage.md"
  },
  // Optional: required once any project lists upstreams.
  "upstream": {
    "enabled": false,
    "promptFile": "/absolute/path/to/upstream-review.md",
    "checkMinutes": 360
  },
  "factorySkill": "/absolute/path/to/software-factory/SKILL.md",
  "projects": [
    {
      "name": "Example application",
      "enabled": true,
      "key": "APP",
      "kanvilId": "YOUR_KANVIL_PROJECT_ID",
      "t3Id": "YOUR_T3_PROJECT_ID",
      "repoPath": "/absolute/path/to/repository",
      "githubRepo": "OWNER/REPOSITORY",
      "baseBranch": "main",
      "readyStatuses": ["todo"],
      "doneStatuses": ["done"],
      "priorityLabels": [],
      // Optional: untrusted reports in another Kanvil project, triaged against this project and its repository.
      // "scopes": ["app", "web"],
      // "inbox": { "kanvilId": "YOUR_INBOX_KANVIL_PROJECT_ID", "label": "intake" },
      // Optional inbox promotion limit: omit or null for unlimited, 0 to pause, N per rolling 24 hours.
      // "inbox": { "kanvilId": "YOUR_INBOX_KANVIL_PROJECT_ID", "label": "intake", "maxPromotionsPerDay": 5 },
      // When the intake holds every new report, name that hold so promotion can ignore it:
      // "inbox": { "kanvilId": "YOUR_INBOX_KANVIL_PROJECT_ID", "label": "intake", "intakeHold": "Untrusted intake: human triage required" },
      "upstreams": [
        { "name": "Example library", "repo": "OWNER/LIBRARY", "prereleases": false, "firstBase": "v1.0.0" }
      ]
    }
  ]
}
